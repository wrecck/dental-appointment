# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Required on Vercel so Auth.js trusts the deployment host
AUTH_TRUST_HOST=true

# Your production app URL (no trailing slash)
AUTH_URL="https://dental-appointment-psi.vercel.app"

# Neon Postgres
# Use the pooled connection string for the app (ends with -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
